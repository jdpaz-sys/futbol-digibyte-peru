# ==============================================================================
# Fútbol Digibyte Perú — Variables de Entorno Backend Go (Fase 1B)
# Copiar a backend/.env y ajustar valores locales (backend/.env está ignorado en Git)
# ==============================================================================

# Entorno y servidor HTTP
APP_ENV=development
PORT=8080

# PostgreSQL 16 + PostGIS 3.4 (ajustar puerto según POSTGRES_PORT en infra/.env, ej. 5434)
DATABASE_URL=postgres://fdp_app:change_me_postgres_dev_2026@127.0.0.1:5434/futbol_digibyte?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Valkey 8 autenticado (sesiones/refresh tokens, rate limiting y caché)
VALKEY_ADDR=127.0.0.1:6379
VALKEY_PASSWORD=change_me_valkey_dev_2026
VALKEY_DB=0

# Autenticación JWT (JWT_SECRET obligatorio, mínimo 32 caracteres aleatorios)
JWT_SECRET=replace_with_at_least_32_random_characters_secret_key
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# CORS (orígenes separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Bootstrap idempotente del primer SUPER_ADMIN (usar con flag -seed-admin)
BOOTSTRAP_ADMIN_EMAIL=admin@digibyte.pe
BOOTSTRAP_ADMIN_PASSWORD=change_me_super_admin_2026
BOOTSTRAP_ADMIN_NOMBRE=Super Administrador Digibyte
