# PostgreSQL 16 + PostGIS 3.4
# Nota: si el puerto 5432 ya está ocupado en tu host, ajusta POSTGRES_PORT (ej. 5434)
POSTGRES_DB=futbol_digibyte
POSTGRES_USER=fdp_app
POSTGRES_PASSWORD=change_me_postgres_dev_2026
POSTGRES_PORT=5432

# Valkey 8 (caché, sesiones, rate limiting y apoyo TTL a Holds)
VALKEY_PASSWORD=change_me_valkey_dev_2026
VALKEY_PORT=6379
